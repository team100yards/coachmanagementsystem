rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Settings (App Branding & Credentials)
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Teams: Teams management, squads, lineups, and staff
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // Players: Player registration, squad database, and player photos
    match /players/{playerId} {
      allow read, write: if true;
    }

    // Match Reports Archive & Live Notes from iPhone / Mobile
    match /match_reports/{reportId} {
      allow read, write: if true;
    }
    match /match_live_notes/{sessionId}/{allSubcollections=**} {
      allow read, write: if true;
    }

    // Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}